# LLM — DeepSeek API
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com
OFFLINE_MODE=false

# SQLite
SQLITE_DB=data/triage.db
CHECKPOINT_DB=data/checkpoints.db
SIEM_ALERT_LIMIT=5000
DATA_DIR=data

# Playbook RAG (Qdrant, optional)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=incident_playbooks
RAG_ENABLED=true
# Playbook ingest (darkknight25/Incident_Response_Playbook_Dataset)
USE_INGESTED_PLAYBOOKS=true

# Human-in-the-loop
HITL_BACKEND=cli
SLACK_WEBHOOK_URL=

# Langfuse tracing (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
